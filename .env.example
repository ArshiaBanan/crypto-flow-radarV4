APP_ENV=dev
LOG_LEVEL=INFO

# Core sources
BINANCE_ENABLED=true
DATA_ENGINE_ENABLED=true
LCW_ENABLED=true
LCW_API_KEY=
CRYPTOMETER_ENABLED=true
CRYPTOMETER_API_KEY=

# Storage: sqlite remains current core store; PostgreSQL is the production migration target
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/radar.db

# v2.0 production controls
V20_ENABLED=true
V20_ALERT_COOLDOWN_SECONDS=900
V20_STOP_PCT=1.5
V20_TARGET_PCT=4.0
V20_HORIZON_MIN=60
V20_PER_ALERT_RISK_PCT=1.0
V20_MAX_CORRELATED_EXPOSURE_PCT=3.0
V20_CORRELATION_THRESHOLD=0.75
V20_AUTO_PAPER_SUBMIT=true
ADMIN_API_KEY=

# Telegram (optional; keep disabled until bot/chat are configured)
V20_TELEGRAM_ENABLED=false
V20_TELEGRAM_BOT_TOKEN=
V20_TELEGRAM_CHAT_ID=

# v2.2 observation ledger
V22_OBSERVATION_ENABLED=true
V22_CODE_VERSION=2.2.0
V22_ENVIRONMENT=paper

# v2.3 multi-source live enrichment
V23_ENRICHMENT_ENABLED=false
V23_LCW_INTERVAL_SECONDS=60
V23_CRYPTOMETER_INTERVAL_SECONDS=60
V23_INCLUDE_ORDERBOOK=true

# v2.4 external intelligence + source consensus
V24_INTELLIGENCE_ENABLED=false
V24_COINGLASS_API_KEY=
V24_COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
V24_GECKO_ENABLED=true
V24_GECKO_BASE_URL=https://api.geckoterminal.com/api/v2
V24_GECKO_NETWORKS=solana
V24_GOPLUS_API_KEY=
V24_GOPLUS_ENABLED=true
V24_POLL_SECONDS=30
V24_MIN_CONSENSUS_FAMILIES=2
V24_MIN_CONSENSUS_AGREEMENT=0.65
V24_CONSENSUS_MAX_AGE_MS=180000

# v2.5 production resilience
V25_ENABLED=true
V25_HTTP_TIMEOUT_SECONDS=15
V25_HTTP_MAX_ATTEMPTS=3
V25_BACKOFF_BASE_SECONDS=0.5
V25_BACKOFF_MAX_SECONDS=8
V25_CIRCUIT_FAILURE_THRESHOLD=3
V25_CIRCUIT_OPEN_SECONDS=30
V25_MAX_RESPONSE_BYTES=4000000
V25_FAIL_CLOSED_EXTERNAL=true
V25_MAX_CONCURRENCY=4
V25_MIN_REQUEST_INTERVAL_MS=0

# v3.0 production deployment / observability
V30_ENABLED=true
POSTGRES_URL=
REDIS_URL=
V30_REQUIRE_POSTGRES=false
V30_REQUIRE_REDIS=false
V30_REDIS_LEASE_KEY=crypto-flow-radar:runtime-lease
V30_REDIS_LEASE_TTL_SECONDS=30
V30_REQUIRE_ADMIN_KEY_IN_PROD=true
V30_MAX_HEARTBEAT_AGE_SECONDS=60
POSTGRES_DB=crypto_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=

# v3.1 production storage migration / cutover
V31_STORAGE_SCHEMA_VERSION=storage_v31
V31_MIGRATION_BATCH_SIZE=1000
V31_REQUIRE_POSTGRES_CORE=true
V31_ALLOW_SQLITE_FALLBACK_IN_DEV=true

# v3.2 full ledger dual-write / reconciliation
V32_ENABLED=false
V32_DUALWRITE_MODE=shadow
V32_POLL_SECONDS=2
V32_BATCH_SIZE=500
V32_MAX_PENDING_EVENTS=100
V32_MAX_PENDING_AGE_MS=120000
V32_REQUIRE_RECONCILIATION=false
V32_TABLES=

# v3.6 SaaS identity / email verification / subscriptions
V36_ENABLED=true
V36_SESSION_TTL_SECONDS=1209600
V36_COOKIE_NAME=cfr_session_v36
V36_COOKIE_SECURE=false
V36_REQUIRE_VERIFIED_EMAIL=true
# Gmail SMTP: use a dedicated account and an App Password (not the Gmail account password).
V36_SMTP_HOST=smtp.gmail.com
V36_SMTP_PORT=587
V36_SMTP_USERNAME=your-cfr-gmail@gmail.com
V36_SMTP_PASSWORD=your-16-digit-google-app-password
V36_SMTP_FROM_EMAIL=your-cfr-gmail@gmail.com
V36_EMAIL_MODE=smtp
V36_EMAIL_TIMEOUT_SECONDS=15
V36_BILLING_WEBHOOK_SECRET=replace-with-long-random-secret
V36_TELEGRAM_BOT_TOKEN=
V36_TWILIO_ACCOUNT_SID=
V36_TWILIO_AUTH_TOKEN=
V36_TWILIO_FROM_NUMBER=
# v3.5 SaaS identity / workspace
V35_ENABLED=true
V35_SESSION_TTL_SECONDS=1209600
V35_COOKIE_NAME=cfr_session
V35_COOKIE_SECURE=false
V35_DEFAULT_PLAN=RESEARCH

# v3.7 multi-asset market/data federation
V37_BINANCE_SPOT_ENABLED=true
V37_BINANCE_SPOT_BASE_URL=https://api.binance.com
V37_CMC_ENABLED=true
V37_CMC_API_KEY=
V37_CMC_BASE_URL=https://pro-api.coinmarketcap.com
V37_CMC_LIMIT=200
V37_EXCHANGE_FANOUT_ENABLED=true
V37_OANDA_ENABLED=false
V37_OANDA_BASE_URL=https://api-fxtrade.oanda.com
V37_OANDA_API_TOKEN=
V37_OANDA_ACCOUNT_ID=
V37_FXCM_ENABLED=false
V37_FXCM_BASE_URL=https://endpoints.fxcm.com
V37_FXCM_USERNAME=
V37_FXCM_PASSWORD=
V37_FXCM_TRADING_SESSION_ID=FXCM
V37_FXCM_TRADING_SESSION_SUB_ID=
V37_ARKHAM_API_KEY=
V37_ARKHAM_BASE_URL=https://api.arkm.com
V37_ETHERSCAN_API_KEY=
V37_ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
V37_REFRESH_SECONDS=15

# v3.8 macro / indices / energy / dominance
V38_TRADINGECONOMICS_ENABLED=false
V38_TRADINGECONOMICS_API_KEY=
V38_TRADINGECONOMICS_BASE_URL=https://api.tradingeconomics.com
V38_OANDA_US30_SYMBOL=US30_USD
V38_OANDA_SPX500_SYMBOL=SPX500_USD
V38_OANDA_US100_SYMBOL=NAS100_USD
V38_OANDA_USOIL_SYMBOL=WTICO_USD
V38_OANDA_UKOIL_SYMBOL=BCO_USD

# Integrated upstream pump/dump detector (runs a full scan on this interval)
V40_ENABLED=false
V40_SCAN_INTERVAL_SECONDS=900
V40_SCAN_TIMEOUT_SECONDS=900
V40_SCAN_INTERVAL_MINUTES=15
# Optional detector source credentials (leave blank to skip those sources)
LCW_API_KEY=
CRYPTOMETER_API_KEY=
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
COINGECKO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MONITORED_CHANNELS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
