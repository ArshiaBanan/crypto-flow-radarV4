# =============================
# CRYPTO FLOW RADAR v3.9 ONLINE
# =============================
APP_ENV=production
LOG_LEVEL=INFO

# Core real-time market scanner
BINANCE_ENABLED=true
DATA_ENGINE_ENABLED=true
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/stream
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_WS_MAX_SYMBOLS=80
BINANCE_DEPTH_LEVELS=20

# Production core storage
STORAGE_BACKEND=postgres
POSTGRES_URL=${POSTGRES_URL}
REDIS_URL=${REDIS_URL}
V30_ENABLED=true
V30_REQUIRE_POSTGRES=true
V30_REQUIRE_REDIS=true
V32_ENABLED=true
V32_DUALWRITE_MODE=required
V32_REQUIRE_RECONCILIATION=true

# Alert + paper validation
V20_ENABLED=true
V20_AUTO_PAPER_SUBMIT=true
V20_TELEGRAM_ENABLED=false
V33_ENABLED=true

# SaaS
V36_ENABLED=true
V36_REQUIRE_VERIFIED_EMAIL=true
V36_EMAIL_MODE=smtp
V36_SMTP_HOST=smtp.gmail.com
V36_SMTP_PORT=587
V36_SMTP_USERNAME=${V36_SMTP_USERNAME}
V36_SMTP_PASSWORD=${V36_SMTP_PASSWORD}
V36_SMTP_FROM_EMAIL=${V36_SMTP_FROM_EMAIL}
V36_COOKIE_SECURE=true

# Crypto intelligence (optional, configure licensed keys)
V23_ENRICHMENT_ENABLED=false
V24_INTELLIGENCE_ENABLED=false
V24_GOPLUS_ENABLED=false

# Multi-asset federation
V37_BINANCE_SPOT_ENABLED=true
V37_CMC_ENABLED=false
V37_OANDA_ENABLED=false
V37_FXCM_ENABLED=false
V38_TRADINGECONOMICS_ENABLED=false

# Operational defaults
V39_LIVE_WS_ENABLED=true
V39_LIVE_WS_PUSH_SECONDS=1
PORT=8000

# Integrated upstream pump/dump detector (runs a full scan on this interval)
V40_ENABLED=false
V40_SCAN_INTERVAL_SECONDS=900
V40_SCAN_TIMEOUT_SECONDS=900
V40_SCAN_INTERVAL_MINUTES=15
# Optional detector source credentials (leave blank to skip those sources)
LCW_API_KEY=
CRYPTOMETER_API_KEY=
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
COINGECKO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MONITORED_CHANNELS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
